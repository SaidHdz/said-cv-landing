---
import { PROJECTS } from '../data/projects';

interface Props {
  className?: string;
}

const { className = "" } = Astro.props;
---

<section class={`py-14 border-b border-pine/15 ${className}`} id="proyectos">
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 font-mono text-xs text-muted mb-8 uppercase tracking-wider">
    <div class="flex items-center gap-3">
      <span>[ 02 // ÍNDICE DE PROYECTOS ]</span>
      <span class="text-pine/20">────────────</span>
    </div>
    <span class="text-pine/50">DIRECTORIO_v2.0 // REGISTROS: {PROJECTS.length}</span>
  </div>

  <div class="border border-pine/20 bg-cream/50 overflow-hidden">
    <!-- Header de la tabla tipográfica (Desktop) -->
    <div class="hidden md:grid grid-cols-12 gap-4 px-5 py-3 border-b border-pine/20 bg-cream-2/60 font-mono text-xs uppercase tracking-wider text-muted font-medium">
      <div class="col-span-1 text-pine/60">AÑO</div>
      <div class="col-span-3 text-pine/60">PROYECTO</div>
      <div class="col-span-4 text-pine/60">STACK TÉCNICO</div>
      <div class="col-span-3 text-pine/60">TIPO DE SISTEMA</div>
      <div class="col-span-1 text-right text-pine/60">DETALLE</div>
    </div>

    <!-- Filas del índice -->
    <div class="divide-y divide-pine/10">
      {PROJECTS.map((item) => (
        <div
          class="project-row group p-5 md:py-4 md:px-5 grid grid-cols-1 md:grid-cols-12 gap-2 md:gap-4 items-center hover:bg-cream-2 transition-colors cursor-pointer"
          data-project-id={item.id}
        >
          <!-- Año -->
          <div class="col-span-1 font-mono text-xs text-muted md:text-pine/70">
            <span class="md:hidden text-pine/40 mr-2">AÑO:</span>
            {item.year}
          </div>

          <!-- Título -->
          <div class="col-span-3 font-display text-lg md:text-xl font-bold text-pine group-hover:text-radish transition-colors flex items-center gap-2">
            <span>{item.title}</span>
          </div>

          <!-- Stack -->
          <div class="col-span-4 font-mono text-xs text-pine/80">
            <span class="md:hidden text-muted mr-1">STACK: </span>
            {item.stack}
          </div>

          <!-- Tipo -->
          <div class="col-span-3 font-mono text-xs text-muted">
            <span class="md:hidden mr-1">TIPO: </span>
            {item.type}
          </div>

          <!-- Indicador de acción -->
          <div class="col-span-1 font-mono text-xs text-right text-muted group-hover:text-radish transition-colors flex md:justify-end items-center gap-1 mt-2 md:mt-0">
            <span class="text-[11px] tracking-wider uppercase md:hidden">[ Inspeccionar ]</span>
            <span class="hidden md:inline">[ Ver ]</span>
            <span class="text-xs">→</span>
          </div>
        </div>
      ))}
    </div>
  </div>

  <p class="font-mono text-xs text-muted mt-3">
    * Selecciona cualquier registro del índice para desplegar la ficha técnica, arquitectura y demo interactivo.
  </p>
</section>
